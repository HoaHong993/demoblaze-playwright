{
  "name": "demoblaze-playwright",
  "version": "1.0.0",
  "description": "E2E test automation framework for https://www.demoblaze.com built with Playwright + TypeScript (UI, API, regression, performance).",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:chromium": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:api": "playwright test --project=api",
    "test:perf": "playwright test --project=performance",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "perf:k6": "k6 run perf/k6/load-test.js"
  },
  "keywords": ["playwright", "typescript", "e2e", "qa-automation", "demoblaze"],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  }
}
