# Copy this file to .env and adjust as needed. All values are optional.

# Target environment (only "prod" exists for DemoBlaze, kept to show multi-env support)
TEST_ENV=prod

# Override URLs (default: values from config/environments.ts)
# BASE_URL=https://www.demoblaze.com
# API_URL=https://api.demoblaze.com

# Existing account for login tests.
# If left empty, a fresh random user is created via the sign-up API before the run.
# TEST_USERNAME=
# TEST_PASSWORD=

# Execution
HEADLESS=true
WORKERS=4
RETRIES=1

# Performance budgets (milliseconds)
PERF_PAGE_LOAD_BUDGET_MS=5000
PERF_API_BUDGET_MS=2000
